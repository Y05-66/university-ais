<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ais</groupId>
        <artifactId>university-ais</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>ueas-admin</artifactId>
    <packaging>jar</packaging>
    <dependencies>
        <dependency>
            <groupId>com.ais</groupId>
            <artifactId>ueas-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ais</groupId>
            <artifactId>ueas-basic</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ais</groupId>
            <artifactId>ueas-enrollment</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ais</groupId>
            <artifactId>ueas-score</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ais</groupId>
            <artifactId>ueas-exam</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ais</groupId>
            <artifactId>ueas-evaluation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ais</groupId>
            <artifactId>ueas-notice</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ais</groupId>
            <artifactId>ueas-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
