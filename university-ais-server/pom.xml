<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.ais</groupId>
    <artifactId>university-ais</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>University AIS</name>

    <modules>
        <module>ueas-common</module>
        <module>ueas-security</module>
        <module>ueas-system</module>
        <module>ueas-basic</module>
        <module>ueas-enrollment</module>
        <module>ueas-score</module>
        <module>ueas-exam</module>
        <module>ueas-evaluation</module>
        <module>ueas-notice</module>
        <module>ueas-ai</module>
        <module>ueas-admin</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <sa-token.version>1.38.0</sa-token.version>
        <knife4j.version>4.4.0</knife4j.version>
        <hutool.version>5.8.25</hutool.version>
        <redisson.version>3.25.2</redisson.version>
        <spring-ai.version>1.0.0-M5</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.ais</groupId>
                <artifactId>ueas-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ais</groupId>
                <artifactId>ueas-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ais</groupId>
                <artifactId>ueas-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ais</groupId>
                <artifactId>ueas-basic</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ais</groupId>
                <artifactId>ueas-enrollment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ais</groupId>
                <artifactId>ueas-score</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ais</groupId>
                <artifactId>ueas-exam</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ais</groupId>
                <artifactId>ueas-evaluation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ais</groupId>
                <artifactId>ueas-notice</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ais</groupId>
                <artifactId>ueas-ai</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis-Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Sa-Token -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- Knife4j -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- Hutool -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Redisson -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- Spring AI -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-openai-spring-boot-starter</artifactId>
                <version>${spring-ai.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
